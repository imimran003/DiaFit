# Bind only to a private network or managed ingress in production.
PORT=8787
HOST=127.0.0.1
DIAFIT_DEPLOYMENT_ENV=development

# Development fixture mode never calls a model and requires this bearer token.
# Set a unique local value; do not use this authentication mechanism in production.
DIAFIT_ANALYSIS_MODE=fixture
DIAFIT_AUTH_MODE=development-token
DIAFIT_DEVELOPMENT_TOKEN=replace-with-a-long-local-secret

# Production must use a managed identity provider with signed RS256 access
# tokens. These values are intentionally empty in the local example.
# DIAFIT_DEPLOYMENT_ENV=production
# DIAFIT_AUTH_MODE=jwks
# DIAFIT_AUTH_JWKS_URL=https://identity.example/.well-known/jwks.json
# DIAFIT_AUTH_ISSUER=https://identity.example/
# DIAFIT_AUTH_AUDIENCE=diafit-api

# Meal text/image understanding: disabled, mock (offline), gemini, or openai.
# Provider credentials stay on the backend and are never shipped in the app.
DIAFIT_MEAL_PARSER_MODE=mock
GEMINI_MEAL_MODEL=gemini-3.1-flash-lite
# GEMINI_API_KEY=
OPENAI_MEAL_MODEL=gpt-4.1-mini
# OPENAI_API_KEY=

# Optional text-meal editorial images. This remains disabled by default because
# Google's image-generation API has no free tier; uploaded meal photos need no
# generation and are retained locally by the app after confirmation.
DIAFIT_MEAL_VISUAL_MODE=disabled
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image

# Verified nutrition lookup: disabled or usda. The key remains server-only.
DIAFIT_NUTRITION_PROVIDER_MODE=disabled
NUTRITION_DATA_VERSION=FoodData Central API
# USDA_FDC_API_KEY=

# Maximum requests per caller per rolling minute.
RATE_LIMIT_PER_MINUTE=20
ANALYSIS_TIMEOUT_MS=25000
# Bounded provider transport retry. The same request/idempotency key is reused;
# keep this low so a photo never waits through an unbounded retry chain.
MEAL_PARSE_PROVIDER_ATTEMPTS=2
MEAL_PARSE_RETRY_BASE_MS=250

# A production deployment must provide a real authentication verifier and a
# server-side vision/nutrition provider. Keep provider secrets only there.
# DIAFIT_AUTH_JWKS_URL=
# VISION_PROVIDER_API_KEY=
# NUTRITION_PROVIDER_API_KEY=

# Hosted private-testing equivalent (for render.yaml). Set these in the host's
# secret store, never in the iOS target or Git. A hosted development deployment
# keeps the Mac out of the photo-recognition path but is not public-release auth.
# DIAFIT_DEPLOYMENT_ENV=development
# HOST=0.0.0.0
# DIAFIT_AUTH_MODE=development-token
# DIAFIT_DEVELOPMENT_TOKEN=
